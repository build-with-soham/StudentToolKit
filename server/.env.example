# Copy this file to ".env" and fill in your real values. Never commit ".env".

# Port the backend server runs on
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
# Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/studenttoolkit
MONGODB_URI=your_mongodb_connection_string_here

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=764948392324-36kroi583bbchrovp1f2bp13701hip32.apps.googleusercontent.com

# Any long random string — used to sign your app's own login sessions (JWT)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# The origin your frontend is served from, for CORS.
# Examples: http://127.0.0.1:5500 (VS Code Live Server), https://your-site.netlify.app
CLIENT_ORIGIN=http://127.0.0.1:5500
